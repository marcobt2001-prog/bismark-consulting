f:["$","div",null,{"className":"bg-white","children":[["$","section",null,{"className":"bg-navy-900 text-white py-16 md:py-20","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","h1",null,{"className":"font-display text-5xl md:text-7xl mb-6 tracking-wide","children":"FOOD PRODUCTION"}],["$","p",null,{"className":"text-xl text-gray-300 max-w-3xl leading-relaxed","children":"Ingredient intake through shelf life and regulatory compliance"}]]}]}],["$","section",null,{"className":"py-20 bg-white","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8","children":["$","div",null,{"className":"max-w-[70ch]","children":[["$","h2",null,{"className":"font-display text-4xl md:text-5xl text-navy-900 mb-6","children":"WHAT IT FEELS LIKE"}],["$","div",null,{"className":"bg-gold-600 h-1 w-24 mb-8"}],[["$","p","0",{"className":"text-lg text-gray-700 leading-relaxed mb-6","children":"The clock is always running. Raw materials arrive with variable quality and shelf life. Production schedules are built around demand forecasts that were wrong before the ink dried. Changeovers take too long because the line was designed for fewer SKUs than you’re running today. Sanitation protocols are followed — but the time they consume keeps growing as regulatory requirements expand."}],["$","p","1",{"className":"text-lg text-gray-700 leading-relaxed mb-6","children":"On the floor, operators know which machines drift and which readings to watch. But that knowledge lives in people, not in processes. When the experienced operator is off shift, the same line runs differently. Quality holds happen because the response protocol isn’t clear enough to execute without a supervisor. Traceability is technically possible but operationally painful."}],["$","p","2",{"className":"text-lg text-gray-700 leading-relaxed mb-6","children":"The product ships. The compliance boxes get checked. But the operation runs with more waste, more downtime, more rework, and more risk than the margins can sustain long-term."}]]]}]}]}],["$","section",null,{"className":"py-20 bg-gray-50","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","h2",null,{"className":"font-display text-4xl md:text-5xl text-navy-900 mb-6","children":["PROCESSES: ","FOOD PRODUCTION"," OPERATIONS"]}],["$","div",null,{"className":"bg-gold-600 h-1 w-24 mb-12"}],["$","div",null,{"className":"grid md:grid-cols-2 gap-6","children":[["$","div","0",{"className":"bg-white border-2 border-gray-200 p-8 hover:border-gold-600 transition-colors","children":[["$","h3",null,{"className":"font-display text-xl text-navy-900 font-bold mb-3","children":"Raw Material Receiving & Inspection"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Accepting, inspecting, and dispositioning incoming ingredients and packaging materials. The process where supplier quality becomes your quality."}]]}],["$","div","1",{"className":"bg-white border-2 border-gray-200 p-8 hover:border-gold-600 transition-colors","children":[["$","h3",null,{"className":"font-display text-xl text-navy-900 font-bold mb-3","children":"Ingredient Storage & Inventory Management"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Managing raw material storage conditions, rotation, and availability. The process where FIFO discipline and temperature control determine whether your ingredients are assets or liabilities."}]]}],["$","div","2",{"className":"bg-white border-2 border-gray-200 p-8 hover:border-gold-600 transition-colors","children":[["$","h3",null,{"className":"font-display text-xl text-navy-900 font-bold mb-3","children":"Production Scheduling & Planning"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Sequencing production runs against demand, capacity, and material availability. The process where the gap between the plan and the floor is measured in lost capacity."}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]]}]}],"$L23","$L24","$L25"]}]
